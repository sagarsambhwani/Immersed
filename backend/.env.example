# Database Settings
# Use SQLite locally (aiosqlite driver). For production, replace with postgresql+asyncpg://...
DATABASE_URL=sqlite+aiosqlite:///./chatbot.db

# LLM Provider Configuration
# Default configurations. Options: mock, openai, openrouter, groq, anthropic
DEFAULT_LLM_PROVIDER=mock
DEFAULT_LLM_MODEL=mock-gpt

# Provider API Keys
# Optional on backend if passed from frontend headers (X-OpenAI-Key, X-OpenRouter-Key, X-Groq-Key, X-Anthropic-Key)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# CORS Configuration
# Allow the React frontend Vite dev server (default port 5173) to query the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
